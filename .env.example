# Copy to .env and fill in. Never commit .env.

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
PLAYBACK_TOKEN_SECRET=

# Object storage defaults to the local SeaweedFS container — leave these unset for local use.
# For Cloudflare R2: set all of the below and STORAGE_AUTO_SETUP=false. The bucket must NOT have
# public access (no r2.dev subdomain, no custom domain).
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PRESIGN_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_KEY_PREFIX=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# STORAGE_AUTO_SETUP=false

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
MAX_CONCURRENT_STREAMS=2
