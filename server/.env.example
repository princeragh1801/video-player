NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=1
FORCE_HTTPS=false

DATABASE_URL=postgres://video:video@localhost:5432/video
REDIS_URL=redis://localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-1
PLAYBACK_TOKEN_SECRET=change-me-change-me-change-me-change-me-2

# Cloudflare R2 (S3 API). Local dev uses MinIO from docker-compose.
# R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto  S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=videos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

MAX_CONCURRENT_STREAMS=2
PLAYBACK_TOKEN_TTL_SECONDS=120
PLAYBACK_HEARTBEAT_SECONDS=30
PLAYBACK_SESSION_STALE_SECONDS=90
MAX_UPLOAD_BYTES=10737418240
WORKER_CONCURRENCY=1
DELETE_SOURCE_AFTER_PROCESSING=false
